	"dependencies": {
		"@emoji-mart/data": "^1.2.1",
		"@fontsource-variable/roboto": "^5.3.0",
		"@twemoji/api": "^16.0.1",
		"cache-manager": "^6.4.3",
		"emoji-mart": "^5.6.0",
		"jwt-decode": "^4.0.0",
		"lucide-svelte": "^0.506.0",
		"svelte-floating-ui": "^1.6.2"
	}
}
