DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=
BACKEND_HOST=http://backend:5000
# Public-facing URL of the app (e.g. http://localhost:8080 or https://yourdomain.com).
# Required by SvelteKit's adapter-node so CSRF protection works correctly behind
# the nginx reverse proxy. Must match the origin the browser uses to reach the site.
PUBLIC_ORIGIN=http://localhost:8080
